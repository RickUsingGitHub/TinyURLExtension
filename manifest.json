{
  "manifest_version": 3,
  "name": "TinyURL Shortener",
  "version": "1.0",
  "description": "Shortens the current tab's URL using the TinyURL API.",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "storage",
    "scripting"
  ],
  "action": {
    "default_icon": "icon.svg"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html"
}
